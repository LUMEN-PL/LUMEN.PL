msgid "&Activate"
msgstr "&Aktywuj"

msgid "&Close"
msgstr "&Zamknij"

msgid "&Define"
msgstr "&Definiuj"

msgid "&Delete"
msgstr "&Usuń"

msgid "&New"
msgstr "&Nowy"

msgid "&Rename"
msgstr "&Zmień nazwę"

msgid "&Saved profiles"
msgstr "&Zachowane profile"

msgid "Accord"
msgstr "Akord"

msgid "Activate profile"
msgstr "Aktywuj profil"

msgid "Another profile has the same name as the entered name. Please choose a different name."
msgstr "Inny profil ma taką samą nazwę. Proszę wybrać inną nazwę."

msgid "Are you sure you want to delete the profile named {name}? This cannot be undone."
msgstr "Czy chcesz usunąć profil nazwany {name}? ta operacja jest nieodwracalna."

msgid "Braille"
msgstr "Brajl"

msgid "Configuration"
msgstr "Ustawienia"

msgid "Defining profile {profileName} for {aName}"
msgstr "Definiowanie profilu {profileName} dla {aName}"

msgid "Delete profile"
msgstr "Usuń profil"

msgid "Do you want to activate the profile named {name}?"
msgstr "Czy chcesz aktywować profil nazwany {name}?"

msgid "Error"
msgstr "Błąd"

msgid "Golden Shortcut"
msgstr "Golden Shortcut"

msgid "Moves the braille display to the next line"
msgstr "Przenosi linijkę brajlowską do następnej linii"

msgid "Moves the braille display to the previous line"
msgstr "Przenosi linijkę brajlowską do poprzedniej linii"

msgid "NVDA default settings"
msgstr "Fabryczne ustawienia NVDA"

msgid "Name"
msgstr "Nazwa"

msgid "New name"
msgstr "Nowa nazwa"

msgid "New profile"
msgstr "Nowy profil"

msgid "No profile has been created for this application yet. Click \"New\" to create a profile."
msgstr "Dla tej aplikacji nie utworzono jeszcze żadnego profilu. Kliknij \"Nowy\" aby utworzyć profil."

msgid "Opens a dialog listing profiles for the current application"
msgstr "Otwiera dialog pokazujący wszystkie profile dla aktualnej aplikacji"

msgid "Please choose a different name."
msgstr "Proszę wybrać inną nazwę."

msgid "Please create some profiles."
msgstr "Proszę stworzyć profile."

msgid "Press Enter, then press the key or keyboard shortcut you want to assign to this EAB action"
msgstr "Kliknij Enter, a następnie klawisz lub skrót, który chcesz przypisać do tej akcji listwy EAB"

msgid "Profile name"
msgstr "Nazwa profilu"

msgid "Profile selector for %s"
msgstr "Wybór profilu dla %s"

msgid "Rename"
msgstr "Zmień nazwę"

msgid "Scrolls the braille display back"
msgstr "Przewija brajl do tyłu"

msgid "Scrolls the braille display forward"
msgstr "Przewija brajl w przód"

msgid "Shortcut"
msgstr " Skrót"

msgid "Shows NVDA's braille settings"
msgstr "Otwiera Ustawienia brajla"

msgid "Sorry, something went terribly wrong."
msgstr "Coś poszło nie tak"

